#!/bin/bash
# Deinstallation (laeuft als root). Beendet den Dienst DIESES Plugin-Ordners und entfernt die RAM-Daten.
# Argumente von LoxBerry: $1 Temp-Name, $2 Plugin-Name, $3 Plugin-Ordner, $4 Version, $5 LBHOMEDIR
# Der Ordner kommt aus $3 (kann z. B. nut2lox_000 heissen). Ein fest eingetragener Ordner wuerde den Dienst eines anderen Plugins beenden.
# Die sudo-Erlaubnis aus sudoers/sudoers entfernt LoxBerry selbst; die Datei der Vorgaengerversionen wird hier entfernt.
# Der lokale NUT-Server (/etc/nut) und die Pakete bleiben bestehen - sie gehoeren dem System.
FOLDER="${3:-nut2lox}"
PIDFILE="/dev/shm/$FOLDER/nut.pid"

if [ -f "$PIDFILE" ]; then
    PID="$(cat "$PIDFILE")"
    if [ -n "$PID" ] && kill "$PID" 2>/dev/null; then
        for i in $(seq 1 20); do      # bis zu 10 s auf ein sauberes Ende warten
            kill -0 "$PID" 2>/dev/null || break
            sleep 0.5
        done
        kill -9 "$PID" 2>/dev/null
    fi
fi

# Sicherheitsnetz: Prozesse aus dem Programmordner genau dieses Plugins
if command -v pkill >/dev/null 2>&1; then
    pkill -f "plugins/$FOLDER/nutd.php" 2>/dev/null
fi

rm -rf "/dev/shm/$FOLDER"
rm -f "/etc/sudoers.d/nut-plugin-$FOLDER"      # Datei der Vorgaengerversionen (ab 0.8.0 kommt die sudo-Erlaubnis aus sudoers/sudoers, die LoxBerry selbst entfernt)
exit 0
